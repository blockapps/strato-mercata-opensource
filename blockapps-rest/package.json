{
  "name": "blockapps-rest",
  "version": "8.5.0",
  "description": "BlockApps Rest API SDK",
  "main": "dist/index.js",
  "scripts": {
    "clean": "rimraf dist lib docs",
    "build": "npm run clean && npm run build:types && npm run build:cjs && npm run build:esm",
    "build:types": "tsc --emitDeclarationOnly --outDir dist/types",
    "build:cjs": "tsc --module CommonJS --outDir dist/cjs --removeComments",
    "build:esm": "tsc --module ES2022 --outDir dist/esm --removeComments",
    "dev": "tsx --watch src/index.ts",
    "docs": "typedoc src/index.ts --out docs",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "type-check": "tsc --noEmit",
    "test": "yarn test:lib && yarn test:util",
    "test:lib": "mocha --require=@babel/register lib/test/*.test.js -b",
    "test:util": "mocha --require=@babel/register lib/util/test/*.test.js -b",
    "token-getter": "ts-node --require=@babel/register src/util/oauth.client.ts"
  },
  "keywords": [
    "BlockApps",
    "STRATO",
    "rest",
    "api"
  ],
  "author": "support@blockapps.net",
  "license": "ISC",
  "engines": {
    "node": ">= 22.16.0"
  },
  "dependencies": {
    "@types/simple-oauth2": "^2.2.1",
    "@types/tcp-port-used": "^1.0.0",
    "@babel/polyfill": "^7.8.3",
    "axios": "^0.21.2",
    "bignumber.js": "^9.0.0",
    "bluebird": "^3.4.6",
    "chai": "^4.2.0",
    "chai-bignumber": "^3.0.0",
    "commander": "^5.1.0",
    "dotenv": "^6.2.0",
    "envfile": "^3.0.0",
    "express": "^4.16.4",
    "flatted": "^2.0.1",
    "fs": "0.0.1-security",
    "http-status-codes": "^1.3.0",
    "https": "1.0.0",
    "ip": "^1.1.5",
    "js-yaml": "^3.13.1",
    "jsonwebtoken": "8.4.0",
    "open": "^6.0.0",
    "query-string": "^6.2.0",
    "rsa-pem-from-mod-exp": "0.8.5",
    "sha3": "^2.1.3",
    "simple-oauth2": "2.2.1",
    "@solidity-parser/parser": "^0.14.1",
    "tcp-port-used": "^1.0.1",
    "unix-time": "1.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.8.4",
    "@babel/plugin-proposal-object-rest-spread": "^7.8.4",
    "@babel/polyfill": "^7.8.3",
    "@babel/preset-env": "^7.8.4",
    "@babel/register": "^7.8.4",
    "@types/mocha": "^8.0.3",
    "@types/node": "24.0.0",
    "babel-preset-minify": "^0.5.1",
    "eslint": "^4.19.1",
    "eslint-config-airbnb": "^17.0.0",
    "eslint-plugin-import": "^2.13.0",
    "eslint-plugin-jsx-a11y": "^6.0.3",
    "eslint-plugin-react": "^7.10.0",
    "jsdoc": "3.6.7",
    "mocha": "^6.0.2",
    "rimraf": "^6.0.1",
    "ts-node": "^10.0.0",
    "tsx": "^4.20.3",
    "typedoc": "^0.28.5",
    "typescript": "^5.8.3"
  }
}
